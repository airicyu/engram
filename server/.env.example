# Copy to `.env` in this directory (`server/`) and adjust.
# Bun loads `.env` automatically when you `bun run` from here.
# All vars optional — defaults match an empty local prototype.
# Prefer `bun run setup` from the repo root for first-time setup.
#
# 0.21+:除 ENGRAM_STORE_DIR 外，下列鍵皆可改寫在
# {ENGRAM_STORE_DIR}/engram.workspace.yaml（workspace 鍵優先於 env）。
# 見 docs/configurations.md。

# Memory store root (absolute or relative to cwd). Default: <repo>/data
# ENGRAM_STORE_DIR only — cannot be set in workspace yaml.
# ENGRAM_STORE_DIR=../data

# Host temp root for ask jobs + dream agent workdirs (not inside the store). Default: /tmp
# workspace: temp_dir
# ENGRAM_TEMP_DIR=/tmp

# IANA timezone for calendar days + event timestamps
# workspace: timezone
# ENGRAM_TZ=Asia/Hong_Kong

# Memory write language: zh-Hant | zh-Hans | en
# workspace: memory_language
# ENGRAM_MEMORY_LANGUAGE=en

# HTTP listen port (always bound to 127.0.0.1 — localhost only)
# workspace: port
# PORT=8787

# Dream extract runner: claude | cursor | codex | mock-ok | mock-fail | …
# workspace: agent
# ENGRAM_AGENT=claude

# Binary overrides (when using the matching agent)
# workspace: claude_bin | cursor_agent_bin | codex_bin
# CURSOR_AGENT_BIN=agent
# CLAUDE_BIN=claude
# CODEX_BIN=codex

# Cursor OS sandbox (kernel ≥6.2). Default disabled — Engram uses write-policy＋--add-dir.
# workspace: cursor_sandbox (enabled | disabled)
# ENGRAM_CURSOR_SANDBOX=enabled

# Verbose dream extract/apply logs
# workspace: dream_debug (boolean)
# ENGRAM_DREAM_DEBUG=1

# Verbose memory search/ask logs
# workspace: memory_debug (boolean)
# ENGRAM_MEMORY_DEBUG=1

# Allow PUT /clock (virtual memory timeline for time replay). DELETE /clock always allowed.
# workspace: allow_virtual_clock (boolean)
# ENGRAM_ALLOW_VIRTUAL_CLOCK=1

# Warn and continue when store structure is too old (default: refuse start)
# workspace: allow_stale_store (boolean)
# ENGRAM_ALLOW_STALE_STORE=1
