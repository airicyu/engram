# Copy to `.env` in this directory (`web/`) and adjust.
# Bun loads `.env` automatically when you `bun run` from here.

# UI listen port (always bound to 127.0.0.1 — localhost only)
# WEB_PORT=8788

# Upstream Engram API (proxied at /api/*)
# ENGRAM_URL=http://localhost:8787
# (or http://127.0.0.1:8787 — same loopback)
